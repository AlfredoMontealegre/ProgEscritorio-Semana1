<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.uam.edu.ejemplo_g1_1.HelloController"
      style="-fx-background-color: #0692e7">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText" style="-fx-text-fill:#ffffff; -fx-font-size: 20;"/>
    <Label fx:id="lblName" style="-fx-text-fill:#ffffff" text="Dime tu nombre"/>
    <TextField fx:id="tfName"></TextField>
    <Button text="Saludar" onAction="#onHelloButtonClick"/>
</VBox>
